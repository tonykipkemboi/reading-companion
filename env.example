# Nebius Token Factory API key. Create one at https://tokenfactory.nebius.com
NEBIUS_API_KEY=

# Optional. Model that writes the explanations. Any live Token Factory chat model works;
# one with image input is needed for the snip tool. Leave empty for the built-in default.
NEBIUS_MODEL=

# Optional. Page to open at launch instead of the home screen.
START_URL=

# Optional. Companion to use: quippy, snippy or tippy. Leave empty to pick in the app.
COMPANION_MASCOT=

# Optional. Rename the companion without changing its design.
COMPANION_NAME=
